%% ---------------
img1 = imread('project_images/clean/original_boat.png');

F1 = fft2(double(img1));
F1_shifted = fftshift(F1);

magnitude = log(1 + abs(F1_shifted));
figure;
subplot(1,4,1);
imshow(uint8(img1));
title('Original Image');
subplot(1,4,2);
imshow(magnitude, []); 
title('FFT of Original Image');

img2 = imread('project_images/degraded/degraded_boat.png');

F2 = fft2(double(img2));
F2_shifted = fftshift(F2);

magnitude = log(1 + abs(F2_shifted));
subplot(1,4,3);
imshow(magnitude, []); 
title('FFT of Degraded Image');
subplot(1,4,4);
imshow(uint8(img2));
title('Degr');
