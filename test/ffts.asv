im = imread("project_images/degraded/degraded_peppers.png");

figure;
subplot(1,3,1);
imshow(uint8(im));

subplot(1,3,2);
imshow(uint8(adaptive_median_filtering(im,9)));

subplot(1,3,3);
imshow(uint8(medfilt2(im, [5 5])));