clc; clear; close all;

img1 = imread('project_images/clean/original_baboon.png');

F1 = fft2(double(img1));
F1_shifted = fftshift(F1);

magnitude = log(1 + abs(F1_shifted));
figure;
subplot(1,2,1);
imshow(magnitude, []); 
title('FFT of Original');

img2 = imread('project_images/degraded/degraded_baboon.png');

F2 = fft2(double(img2));
F2_shifted = fftshift(F2);

magnitude = log(1 + abs(F2_shifted));
subplot(1,2,2);
imshow(magnitude, []); 
title('FFT of Degraded');
